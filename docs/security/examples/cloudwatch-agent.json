{
  "agent": {
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/pods/eggrd-edge_eggrd-*/eggrd/*.log",
            "log_group_name": "/eggrd/edge",
            "log_stream_name": "{instance_id}-eggrd",
            "retention_in_days": 90,
            "timezone": "UTC"
          }
        ]
      }
    }
  }
}
